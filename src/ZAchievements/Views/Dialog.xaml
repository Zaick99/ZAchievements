<views:ShellWindow x:Class="ZAchievements.Views.Dialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:ZAchievements.Views"
                   x:ClassModifier="internal"
                   Style="{StaticResource Shell}"
                   SizeToContent="Height"
                   Width="440"
                   ResizeMode="NoResize"
                   ShowInTaskbar="False"
                   WindowStartupLocation="CenterOwner">

  <Grid Margin="0,0,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- caption -->
    <Border Grid.Row="0" Style="{StaticResource CaptionBar}" Height="36" MouseLeftButtonDown="OnCaptionDrag">
      <Grid>
        <TextBlock Style="{StaticResource Caption}"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   Text="ZAchievements" />
        <Button Style="{StaticResource CloseButton}"
                HorizontalAlignment="Right"
                Content="&#xE8BB;" AutomationProperties.Name="Close"
                Command="{x:Static SystemCommands.CloseWindowCommand}" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="24,4,24,20">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock x:Name="Glyph"
                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="18"
                   Foreground="{StaticResource Warn}"
                   VerticalAlignment="Center"
                   Text="&#xE7BA;" />
        <TextBlock x:Name="Heading"
                   Style="{StaticResource Display}"
                   FontSize="18"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock x:Name="Body"
                 Foreground="{StaticResource TextMuted}"
                 TextWrapping="Wrap"
                 LineHeight="19" />
    </StackPanel>

    <Border Grid.Row="2" Background="{StaticResource Sunken}" Padding="16,14">
      <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" />
    </Border>
  </Grid>
</views:ShellWindow>
