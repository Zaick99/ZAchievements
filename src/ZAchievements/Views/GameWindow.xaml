<views:ShellWindow x:Class="ZAchievements.Views.GameWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:ZAchievements.Views"
                   xmlns:achievements="clr-namespace:ZAchievements.Achievements"
                   x:ClassModifier="internal"
                   Style="{StaticResource Shell}"
                   Title="ZAchievements"
                   Width="940" Height="760"
                   MinWidth="640" MinHeight="480"
                   WindowStartupLocation="CenterScreen">

  <views:ShellWindow.Resources>

    <DataTemplate x:Key="AchievementItem" DataType="{x:Type achievements:AchievementRow}">
      <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Background="Transparent">
        <Grid Height="66" Margin="0,0,4,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- unlocked marker -->
          <Border Grid.Column="0" Background="{StaticResource Accent}" Margin="0,10" CornerRadius="2">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Opacity" Value="0" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>

          <Border Grid.Column="1" Width="44" Height="44" Margin="13,0,0,0"
                  CornerRadius="{StaticResource RadiusSmall}"
                  Background="{StaticResource Sunken}" ClipToBounds="True"
                  Loaded="OnIconRealized">
            <Image Source="{Binding Icon}" Stretch="UniformToFill">
              <Image.Style>
                <Style TargetType="Image">
                  <Setter Property="Opacity" Value="1" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                      <Setter Property="Opacity" Value="0.28" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Image.Style>
            </Image>
          </Border>

          <StackPanel Grid.Column="2" Margin="14,0,14,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Ellipse Width="6" Height="6" Margin="8,2,0,0" Fill="{StaticResource Warn}"
                       VerticalAlignment="Center" ToolTip="Changed, not saved yet">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsModified}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}"
                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
          </StackPanel>

          <TextBlock Grid.Column="3" Style="{StaticResource Tiny}" VerticalAlignment="Center"
                     Text="{Binding UnlockedAtText}" TextAlignment="Right" MinWidth="104" />

          <TextBlock Grid.Column="4" Text="&#xE72E;" Margin="12,0,0,0"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                     Foreground="{StaticResource Warn}" VerticalAlignment="Center"
                     ToolTip="Steam validates this one on its servers — the write may be refused">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsProtected}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <ToggleButton Grid.Column="5" Style="{StaticResource SwitchToggle}" Margin="16,0,8,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsUnlocked, Mode=TwoWay}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="StatisticItem" DataType="{x:Type achievements:StatRow}">
      <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
        <Grid Height="46" Margin="13,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="130" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource Tiny}" Text="{Binding Id}" Margin="0,2,0,0" />
          </StackPanel>

          <TextBox Grid.Column="1" Style="{StaticResource ValueBox}" VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   IsEnabled="{Binding IsEditable}"
                   Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Grid.Column="2" Style="{StaticResource Tiny}" VerticalAlignment="Center"
                     Text="{Binding Note}" />
        </Grid>
      </Border>
    </DataTemplate>

  </views:ShellWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============ banner and caption ============ -->
    <Grid Grid.Row="0" Height="156">
      <Image x:Name="BannerArt" Stretch="UniformToFill" Opacity="0.75">
        <Image.Effect>
          <BlurEffect Radius="42" KernelType="Gaussian" />
        </Image.Effect>
      </Image>
      <Border Background="{StaticResource BannerScrim}" />

      <Grid VerticalAlignment="Top">
        <Border Style="{StaticResource CaptionBar}" MouseLeftButtonDown="DragCaption">
          <Grid>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
              <Image Source="/Assets/ZAchievements.ico" Width="18" Height="18"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Style="{StaticResource Caption}" Margin="9,0,0,0" VerticalAlignment="Center"
                         Text="ZAchievements" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                      Command="{x:Static SystemCommands.MinimizeWindowCommand}" />
              <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" />
              <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                      Command="{x:Static SystemCommands.CloseWindowCommand}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid Margin="16,0,20,16" VerticalAlignment="Bottom">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="106" Height="40" CornerRadius="{StaticResource RadiusSmall}"
                Background="{StaticResource Sunken}" ClipToBounds="True"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1">
          <Image x:Name="CapsuleArt" Stretch="UniformToFill" />
        </Border>

        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="GameTitle" Style="{StaticResource Display}" FontSize="22"
                     TextTrimming="CharacterEllipsis" Text="…" />
          <TextBlock x:Name="GameTally" Style="{StaticResource Caption}" Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Column="2" Width="58" Height="58">
          <Ellipse Stroke="{StaticResource Hairline}" StrokeThickness="5" />
          <views:Ring x:Name="CompletionRing" Stroke="{StaticResource Accent}" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Progress="0" />
          <TextBlock x:Name="CompletionText" HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="{StaticResource FontSmall}" FontWeight="SemiBold" Text="—" />
        </Grid>
      </Grid>
    </Grid>

    <!-- ============ tabs and filters ============ -->
    <TabControl x:Name="Sections" Grid.Row="1" Style="{StaticResource SegmentedTabs}" Margin="16,12,20,0">
      <TabItem Style="{StaticResource SegmentedTab}" Header="Achievements">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="AchievementSearch" Grid.Column="0" Style="{StaticResource SearchBox}"
                   Tag="Search achievements" TextChanged="OnAchievementFilterChanged" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
            <ToggleButton x:Name="ShowLocked" Style="{StaticResource PillToggle}" Content="Locked"
                          Checked="OnLockedFilter" Unchecked="OnLockedFilter" />
            <ToggleButton x:Name="ShowUnlocked" Style="{StaticResource PillToggle}" Content="Unlocked"
                          Margin="6,0,0,0" Checked="OnUnlockedFilter" Unchecked="OnUnlockedFilter" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Style="{StaticResource SegmentedTab}" Header="Statistics">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="StatSearch" Grid.Column="0" Style="{StaticResource SearchBox}"
                   Tag="Search statistics" TextChanged="OnStatFilterChanged" />
          <CheckBox x:Name="AllowStatEditing" Grid.Column="1" Style="{StaticResource CheckSwitch}"
                    Margin="14,0,0,0" VerticalAlignment="Center"
                    Content="I know editing statistics can break a game"
                    Click="OnStatEditingToggled" />
        </Grid>
      </TabItem>
    </TabControl>

    <!-- ============ rows ============ -->
    <Grid Grid.Row="2" Margin="16,12,14,0">
      <ListBox x:Name="AchievementList"
               Style="{StaticResource PlainList}"
               ItemContainerStyle="{StaticResource PlainItem}"
               ItemTemplate="{StaticResource AchievementItem}" />

      <ListBox x:Name="StatList"
               Style="{StaticResource PlainList}"
               ItemContainerStyle="{StaticResource PlainItem}"
               ItemTemplate="{StaticResource StatisticItem}"
               Visibility="Collapsed" />

      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="Collapsed">
        <TextBlock x:Name="EmptyHeadline" Style="{StaticResource Display}" FontSize="16"
                   HorizontalAlignment="Center" Text="Nothing here" />
        <TextBlock x:Name="EmptyHint" Style="{StaticResource Caption}" Margin="0,6,0,0"
                   HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <!-- ============ footer ============ -->
    <Border Grid.Row="3" Background="{StaticResource Sunken}" BorderBrush="{StaticResource Hairline}"
            BorderThickness="0,1,0,0" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Text="Starting up…"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="DownloadText" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="ResetButton" Style="{StaticResource DangerButton}" Content="Reset…"
                  Click="OnReset" />
          <Button x:Name="LockAllButton" Style="{StaticResource GhostButton}" Content="Lock all"
                  Margin="8,0,0,0" Click="OnLockAll" />
          <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                  Margin="8,0,0,0" ToolTip="Reload from Steam" Click="OnReload" />
          <Button x:Name="SaveButton" Style="{StaticResource GhostButton}" Content="Save changes"
                  Margin="8,0,0,0" Click="OnSave" />
          <Button x:Name="UnlockAllButton" Style="{StaticResource PrimaryButton}" Content="Unlock all &amp; save"
                  Margin="8,0,0,0" Click="OnUnlockAllAndSave" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</views:ShellWindow>
