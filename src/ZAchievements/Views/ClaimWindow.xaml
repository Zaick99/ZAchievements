<views:ShellWindow x:Class="ZAchievements.Views.ClaimWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:ZAchievements.Views"
                   xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                   x:ClassModifier="internal"
                   Style="{StaticResource Shell}"
                   Title="ZAchievements — claim free games"
                   Width="1040" Height="760"
                   MinWidth="720" MinHeight="520"
                   WindowStartupLocation="CenterOwner">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============ caption ============ -->
    <Border Grid.Row="0" Style="{StaticResource CaptionBar}" MouseLeftButtonDown="DragCaption">
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <Image Source="/Assets/ZAchievements.ico" Width="18" Height="18"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Style="{StaticResource CaptionTitle}" Margin="9,0,0,0" Text="Claim free games" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" AutomationProperties.Name="Minimize"
                  Command="{x:Static SystemCommands.MinimizeWindowCommand}" />
          <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" AutomationProperties.Name="Maximize" Click="OnMaximize" />
          <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" AutomationProperties.Name="Close"
                  Command="{x:Static SystemCommands.CloseWindowCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ explanation ============ -->
    <Border Grid.Row="1" Margin="16,0,16,12" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="1"
            CornerRadius="{StaticResource Radius}" Padding="16,13">
      <StackPanel>
        <TextBlock x:Name="Headline" Style="{StaticResource Display}" FontSize="15"
                   Text="Sign in to Steam below" />
        <TextBlock x:Name="Explanation" Style="{StaticResource Caption}" Margin="0,5,0,0"
                   TextWrapping="Wrap"
                   Text="This is Steam's own login page. ZAchievements never sees what you type: the requests run inside the page, exactly like the store's own Play Game button. Steam caps free activations, so a long run pauses and resumes on its own." />
      </StackPanel>
    </Border>

    <!-- ============ the store itself ============ -->
    <Border Grid.Row="2" Margin="16,0,16,0" CornerRadius="{StaticResource Radius}"
            ClipToBounds="True" Background="{StaticResource Sunken}">
      <wv2:WebView2 x:Name="Browser" />
    </Border>

    <!-- ============ controls ============ -->
    <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource Sunken}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="16,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ProgressBar x:Name="Progress" Grid.Row="0" Grid.ColumnSpan="2"
                     Style="{StaticResource ThinProgress}" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Text="Starting the browser…" />
          <TextBlock x:Name="DetailText" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="ForgetButton" Style="{StaticResource GhostButton}" Content="Start over"
                  ToolTip="Forget which apps were already tried" Click="OnForget" />
          <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Content="Stop"
                  Margin="8,0,0,0" IsEnabled="False" Click="OnStop" />
          <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Claim them"
                  Margin="8,0,0,0" IsEnabled="False" Click="OnStart" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</views:ShellWindow>
